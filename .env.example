# Razorpay — leave blank to run checkout in test (mock) mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks secret, used by /api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

# Admin login (/admin/login)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 32+ random characters, e.g. `openssl rand -base64 48`
ADMIN_SESSION_SECRET=

# Prefix for every data store (Netlify Blobs / ./data/<namespace>); keeps this site's orders, reviews and visitors separate
KV_NAMESPACE=chikchik

# Cashfree — takes priority over Razorpay when both keys are set.
# Webhook URL: https://<your-domain>/api/payments/cashfree/webhook (signed with the secret key)
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
# sandbox | production
CASHFREE_ENV=sandbox
# true once One Click Checkout is activated on the Cashfree account; adds "Express Checkout" to the cart drawer
CASHFREE_ONE_CLICK=false
