# Razorpay — leave blank to run checkout in test (mock) mode
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Webhooks secret, used by /api/payments/webhook
RAZORPAY_WEBHOOK_SECRET=

# Admin login (/admin/login)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# 32+ random characters, e.g. `openssl rand -base64 48`
ADMIN_SESSION_SECRET=
